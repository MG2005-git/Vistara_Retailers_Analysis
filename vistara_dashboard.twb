      <column caption='Avg Items Per Transactions' datatype='real' name='[Calculation_1803410240569810944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity]) / COUNTD([invoice_id])' />
      </column>
      <column caption='KPI- Profit Margin' datatype='real' name='[Calculation_351562310337736704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([total_price])' />
      </column>
      <column caption='Average Transaction Value' datatype='real' name='[Calculation_351562310338646018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_price]) / COUNTD([invoice_id])' />
      </column>
